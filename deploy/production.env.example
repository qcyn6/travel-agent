# Copy to .env.production on the server; never commit the real file.
# Use hexadecimal random passwords here so DATABASE_URL interpolation needs no escaping.
DOMAIN=replace-with-your-real-domain
MYSQL_ROOT_PASSWORD=
MYSQL_APP_PASSWORD=
REDIS_PASSWORD=
AUTH_SECRET=
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=120
APP_ENV=production
AUTH_REQUIRED=true
DATABASE_AUTO_INITIALIZE=false
PLANNING_QUEUE_ENABLED=true
RATE_LIMIT_ENABLED=true
PLANNING_MAX_ACTIVE_JOBS=4
PLANNING_MAX_ACTIVE_JOBS_PER_USER=1
PLANNING_JOBS_PER_USER_PER_DAY=10
PLANNING_JOBS_PER_DAY=50
USER_COMPUTE_REQUESTS_PER_DAY=100
GLOBAL_COMPUTE_REQUESTS_PER_MINUTE=40
GLOBAL_COMPUTE_REQUESTS_PER_DAY=500
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
AMAP_API_KEY=
AMAP_MCP_URL=https://mcp.amap.com/mcp
QWEATHER_API_KEY=
QWEATHER_API_HOST=
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
PLANNING_CHECKPOINT_PATH=/app/data/planning_checkpoints.sqlite3
CHROMA_PATH=/app/data/chroma
GUIDE_KNOWLEDGE_PATH=/app/data/knowledge/guides
ALERT_WEBHOOK_URL=
