FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 TZ=Asia/Shanghai
WORKDIR /app
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --create-home app
COPY pyproject.toml constraints-production.txt ./
COPY backend ./backend
RUN pip install --no-cache-dir -c constraints-production.txt .
COPY scripts ./scripts
COPY data/knowledge/guides ./data/knowledge/guides
RUN mkdir -p data/chroma && chown -R app:app /app
USER app
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*", "--no-access-log"]
