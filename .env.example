APP_ENV=development
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/travel_agent?charset=utf8mb4
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
AMAP_API_KEY=
AMAP_BASE_URL=https://restapi.amap.com
ROUTE_TIMEOUT_SECONDS=8
ROUTE_MAX_RETRIES=2
QWEATHER_API_KEY=
QWEATHER_API_HOST=
QWEATHER_TIMEOUT_SECONDS=8
SCHEDULE_DAY_START_TIME=09:00
SCHEDULE_MEAL_MINUTES=90
SCHEDULE_BUFFER_MINUTES=60
EVALUATOR_MAX_DAY_MINUTES=600
EVALUATOR_MAX_ROUTE_SEGMENT_MINUTES=60
EVALUATOR_MAX_DAILY_ROUTE_MINUTES=180
EVALUATOR_RAIN_PROBABILITY_THRESHOLD=0.5
EVALUATOR_OUTDOOR_RATIO_THRESHOLD=0.5
EVALUATOR_MINIMUM_INTEREST_COVERAGE=0.5
MAX_REPLAN_COUNT=2
REDIS_URL=
REDIS_KEY_PREFIX=travel-agent
REDIS_TIMEOUT_SECONDS=1
REDIS_POI_TTL_SECONDS=86400
REDIS_ROUTE_TTL_SECONDS=10800
REDIS_WEATHER_TTL_SECONDS=3600
REDIS_SEARCH_TTL_SECONDS=43200
# Redis 运行在 WSL2 时填写发行版名称；普通 Redis 留空。
REDIS_WSL_DISTRO=
REDIS_WSL_STARTUP_TIMEOUT_SECONDS=5
WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://api.tavily.com
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_MAX_RETRIES=2
# 首次准备景点知识时的并发数量，默认 3；过高可能触发外部 API 限流。
KNOWLEDGE_MAX_CONCURRENCY=3
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
CHROMA_PATH=data/chroma
# Worker 心跳与租约超时；多进程部署时建议保持心跳明显小于租约超时。
PLANNING_HEARTBEAT_SECONDS=10
PLANNING_WORKER_STALE_SECONDS=90
