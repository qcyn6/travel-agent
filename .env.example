APP_ENV=development
# 机构代理使用自签证书时，将 SSL_CERT_FILE（httpx）与 REQUESTS_CA_BUNDLE
# （requests）设为受信任的 CA PEM 文件路径；不要关闭 HTTPS 证书校验。
# 多用户部署建议启用；开发环境可先保留 false 兼容匿名演示数据。
AUTH_REQUIRED=false
# Production startup rejects this placeholder; use an independently generated random secret (32+ bytes).
AUTH_SECRET=please-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-this-password
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/travel_agent?charset=utf8mb4
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# 普通模式整轮及工具总预算（秒）；普通模式由 Agent 统一控制重试。
GENERAL_TURN_TIMEOUT_SECONDS=90
GENERAL_MEMORY_TIMEOUT_SECONDS=5
GENERAL_ROUTE_TIMEOUT_SECONDS=25
GENERAL_WEATHER_TIMEOUT_SECONDS=12
GENERAL_NEARBY_TIMEOUT_SECONDS=25
GENERAL_GUIDE_TIMEOUT_SECONDS=8
GENERAL_MAX_OUTPUT_TOKENS=1000
PLANNING_AGENT_BACKEND=langchain
# 规划前需求对话：单个 Agent 的整轮预算；不影响正式排程任务。
PLANNING_DIALOGUE_TURN_TIMEOUT_SECONDS=90
# LangGraph 规划状态持久化文件；多进程部署请放在共享持久化卷。
PLANNING_CHECKPOINT_PATH=data/planning_checkpoints.sqlite3
AMAP_API_KEY=
AMAP_MAX_RETRIES=3
HOTEL_ENRICHMENT_CONCURRENCY=2
AMAP_MCP_URL=https://mcp.amap.com/mcp
AMAP_MCP_TIMEOUT_SECONDS=15
AMAP_MCP_SSE_READ_TIMEOUT_SECONDS=20
AMAP_MCP_DETAIL_CONCURRENCY=5
# 路线/距离使用上面的高德 MCP；天气直接使用和风天气 API。
ROUTE_ENRICHMENT_CONCURRENCY=3
QWEATHER_API_KEY=
QWEATHER_API_HOST=
QWEATHER_TIMEOUT_SECONDS=8
WEATHER_ENRICHMENT_CONCURRENCY=3
SCHEDULE_DAY_START_TIME=08:00
SCHEDULE_MEAL_MINUTES=40
SCHEDULE_BUFFER_MINUTES=20
EVALUATOR_MAX_DAY_MINUTES=600
EVALUATOR_MAX_ROUTE_SEGMENT_MINUTES=60
EVALUATOR_MAX_DAILY_ROUTE_MINUTES=180
EVALUATOR_MINIMUM_INTEREST_COVERAGE=0.5
REDIS_URL=
REDIS_KEY_PREFIX=travel-agent
REDIS_TIMEOUT_SECONDS=1
REDIS_POI_TTL_SECONDS=86400
REDIS_ROUTE_TTL_SECONDS=10800
REDIS_WEATHER_TTL_SECONDS=3600
# Redis 运行在 WSL2 时填写发行版名称；普通 Redis 留空。
REDIS_WSL_DISTRO=
REDIS_WSL_STARTUP_TIMEOUT_SECONDS=5
DASHSCOPE_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
CHROMA_PATH=data/chroma
GUIDE_KNOWLEDGE_PATH=data/knowledge/guides
GUIDE_KNOWLEDGE_CHROMA_COLLECTION=travel_guides
KNOWLEDGE_EMBEDDING_BATCH_SIZE=5
# Worker 心跳与租约超时；多进程部署时建议保持心跳明显小于租约超时。
PLANNING_HEARTBEAT_SECONDS=10
PLANNING_WORKER_STALE_SECONDS=90
# 生产环境启用 Redis Streams 外部规划队列，并单独启动 scripts/run_planning_worker.py。
PLANNING_QUEUE_ENABLED=false
PLANNING_QUEUE_BLOCK_SECONDS=5
PLANNING_QUEUE_DEDUP_TTL_SECONDS=86400
PLANNING_QUEUE_MAX_LENGTH=10000
# 可选：失败告警 Webhook；留空时只写结构化日志。
ALERT_WEBHOOK_URL=
ALERT_TIMEOUT_SECONDS=5

# Production: use deploy/production.env.example and the Compose deployment.
# JSON array; production requires explicit HTTPS origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_AUTO_INITIALIZE=true
RATE_LIMIT_ENABLED=true
LOGIN_REQUESTS_PER_MINUTE=20
REGISTER_REQUESTS_PER_HOUR=10
USER_REQUESTS_PER_MINUTE=600
USER_COMPUTE_REQUESTS_PER_MINUTE=20
USER_COMPUTE_REQUESTS_PER_DAY=100
GLOBAL_COMPUTE_REQUESTS_PER_MINUTE=40
GLOBAL_COMPUTE_REQUESTS_PER_DAY=500
PLANNING_MAX_ACTIVE_JOBS=4
PLANNING_MAX_ACTIVE_JOBS_PER_USER=1
PLANNING_JOBS_PER_USER_PER_DAY=10
PLANNING_JOBS_PER_DAY=50
